KAFKA_BROKER=localhost:9092
EMBED_SEARCH_PORT=50051
EMBED_INGEST_PORT=50054
GATEWAYD_PORT=50053
COORDINATOR_ADDR=localhost:8000
INGEST_TOPIC=ingest-events
CONSUMER_GROUP=ingest-consumers

# --- Coordinator / vector-search engine ---------------------------------
# The real coordinator + shard cluster lives in the sibling VectorSearchEngine
# repo (../VectorSearchEngine). VSE_PATH is where docker-compose.yml's
# coordinator/shard* services find its build context -- override if that
# repo is checked out somewhere else on your machine.
VSE_PATH=../VectorSearchEngine
COORDINATOR_METRICS_PORT=9105
SHARD_METRICS_PORT=9106

# --- Metrics / health ports -------------------------------------------
# gatewayd and consumer each run one instance, so their metrics port is
# both the container's internal listen port and the host-side mapping.
GATEWAYD_METRICS_PORT=9101
CONSUMER_METRICS_PORT=9102
# The two embed instances run identical code on a fixed internal metrics
# port (9100, see python/embed_service/server.py); these are only the
# HOST-side ports docker-compose maps them to, so both can be reached from
# the host machine without colliding with each other.
EMBED_SEARCH_METRICS_PORT=9103
EMBED_INGEST_METRICS_PORT=9104

# --- Monitoring stack ---------------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
ALERTMANAGER_PORT=9093
KAFKA_EXPORTER_PORT=9308
GRAFANA_ADMIN_PASSWORD=admin